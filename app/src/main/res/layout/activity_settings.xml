<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

    <!-- Scrollable area for settings -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnConfirm"
        android:padding="16dp">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Setting 1: Text Setting -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Setting label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watermark text"
                    android:textStyle="bold"/>

                <!-- EditText for text input -->
                <EditText
                    android:id="@+id/editWatermarkText"
                    android:hint="BeFake."
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watermark color"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/editWatermarkColor"
                    android:hint="white"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watermark alpha (%)"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/editWatermarkAlpha"
                    android:inputType="number"
                    android:hint="65"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watermark size (px)"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/editWatermarkSize"
                    android:inputType="number"
                    android:hint="58"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Border color"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/editBorderColor"
                    android:hint="black"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Border alpha (%)"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/editBorderAlpha"
                    android:hint="100"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

            </TableRow>

            <!-- RadioGroup for selecting Maximize Quality or Minimize Latency -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Performance Mode"
                    android:textStyle="bold"/>

                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Maximize Quality RadioButton -->
                    <RadioButton
                        android:id="@+id/radioMaximizeQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maximize Quality"
                        android:checked="true" />

                    <!-- Minimize Latency RadioButton (default selected) -->
                    <RadioButton
                        android:id="@+id/radioMinimizeLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minimize Latency" />

                </RadioGroup>
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnResetSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset Settings" />

            </TableRow>

        </TableLayout>
    </ScrollView>

    <!-- Confirmation button -->
    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm Settings"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>
